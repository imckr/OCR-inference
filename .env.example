# ═══════════════════════════════════════════════════════════════════════
#  DotsOCR Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8009

# ── Security (CHANGE IN PRODUCTION) ──────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────
# SQLite (default) — for production use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/dotsocr
DATABASE_URL=sqlite:///./dotsocr.db

# ── Model ─────────────────────────────────────────────────────────────
MODEL_DIR=./models/paddleocr_vl
SERVED_MODEL_NAME=paddleocr-vl
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.9
BACKEND=auto

# ── Rate Limits ───────────────────────────────────────────────────────
FREE_TIER_REQUESTS_PER_MINUTE=10
FREE_TIER_REQUESTS_PER_DAY=100
